<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/background"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="8dp"
    tools:ignore="HardcodedText,ContentDescription">

    <LinearLayout
        android:id="@+id/key_row_1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="1"
            android:text="1" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="2"
            android:text="2" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="3"
            android:text="3" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="4"
            android:text="4" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="5"
            android:text="5" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="6"
            android:text="6" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="7"
            android:text="7" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="8"
            android:text="8" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="9"
            android:text="9" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/n_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="0"
            android:text="0" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/key_row_2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_q"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="q"
            android:text="q" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_w"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="w"
            android:text="w" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="e"
            android:text="e" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_r"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="r"
            android:text="r" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_t"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="t"
            android:text="t" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_y"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="y"
            android:text="y" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_u"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="u"
            android:text="u" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_i"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="i"
            android:text="i" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="o"
            android:text="o" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_p"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="p"
            android:text="p" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/key_row_3"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/blank_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_a"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="a"
            android:text="a" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="s"
            android:text="s" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_d"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="d"
            android:text="d" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_f"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="f"
            android:text="f" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_g"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="g"
            android:text="g" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_h"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="h"
            android:text="h" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_j"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="j"
            android:text="j" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_k"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="k"
            android:text="k" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_l"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="l"
            android:text="l" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/colon_wijesekara"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="59"
            android:text=";"
            android:visibility="gone" />

        <View
            android:id="@+id/blank_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/key_row_4"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/shift"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/key_background"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_shift" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_z"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="z"
            android:text="z" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_x"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="x"
            android:text="x" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="c"
            android:text="c" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_v"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="v"
            android:text="v" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_b"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="b"
            android:text="b" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_n"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="n"
            android:text="n" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/l_m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="m"
            android:text="m" />

        <ImageView
            android:id="@+id/backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/key_background"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_backspace" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/key_row_5"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag=""
            android:text="#!" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/lang"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag=""
            android:textColor="?attr/foreground_2" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/symbol_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="s1"
            android:text="/"
            android:visibility="gone" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/comma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="44"
            android:text="," />

        <ImageView
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:background="@drawable/key_background"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_space_bar"
            android:tag="32" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/comma_wijesekara"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="44"
            android:text=","
            android:visibility="gone" />

        <sithakuru.sinhala.keyboard.KeyboardButton
            android:id="@+id/dot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="46"
            android:text="." />

        <ImageView
            android:id="@+id/action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/key_background"
            android:padding="4dp"
            android:scaleType="centerInside" />

    </LinearLayout>

