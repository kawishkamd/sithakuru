<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_1"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/enable_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:background="@drawable/key_background_not_pressed"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@color/light_1"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="සිතකුරු සක්‍රිය කර නැත."
                android:textColor="@color/night_1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="සක්‍රිය කිරීමට උපදෙස්"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="4dp"
                android:text="1. ඔබගේ දුරකතනයේ යතුරු පුවරු සැකසුම් වෙත පිවිසීම සඳහා පහත බොත්තම මත ඔබන්න."
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/enable_help_step_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="@string/enable_help_step_2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="4dp"
                android:text="එහිදී අනතුරු ඇඟවීමි ලැබේ නම් ඒවා කියවන්න. 'සිතකුරු' සක්‍රිය කිරීමට අවශ්‍ය නම්, ඒවායේ 'OK' හෝ 'හරි' ලෙස දැක්වෙන බොත්තම් ඔබන්න."
                android:textColor="@color/light_1"
                android:textSize="14sp"
                android:textStyle="italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="4dp"
                android:text="3. එම සැකසුම් පිටුවෙන් ඉවත් වීම සඳහා දුරකතනයේ පෙර/ආපසු බොත්තම ඔබන්න."
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/enable_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/blue"
                android:text="යතුරු පුවරු සැකසුම් වෙත යන්න"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/select_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:background="@drawable/key_background_not_pressed"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="සිතකුරු සක්‍රිය කර ඇත."
                android:textColor="@color/yellow"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@color/light_1"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="නමුත් සිතකුරු තෝරා නැත."
                android:textColor="@color/night_1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="සිතකුරු තෝරා ගැනීම සඳහා උපදෙස්"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                android:text="1. යතුරු පුවරු ලැයිස්තුව විවෘත කිරීම සඳහා පහත බොත්තම මත ඔබන්න."
                android:textColor="@color/light_1"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="8dp"
                android:text="2. එම ලැයිස්තුවේ ඇති 'Sithakuru' යන වචනය මත ඔබන්න."
                android:textColor="@color/light_1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/select_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/yellow"
                android:text="යතුරු පුවරු ලැයිස්තුව විවෘත කරන්න"
                android:textColor="@color/night_1"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_horizontal"
            android:text="යතුරු පුවරු මාදිළි"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="English"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_wijesekara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/wijesekara"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_singlish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/singlish"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_horizontal"
            android:text="යතුරු පුවරුවේ පෙනුම"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="යතුරු මායිම්"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/long_press_keys_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="ඔබාගෙන සිටීමෙන් ලිවිය හැකි අකුරු"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="උස"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/height_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                tools:text="100%" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/height"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="අකුරුවල ප්‍රමාණය"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                tools:text="16dp" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/text_size"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_horizontal"
            android:text="යතුරු පුවරුවේ වර්ණ"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/colors_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/colors_night"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/night_2"
                android:buttonTint="@color/light_1"
                android:minHeight="48dp"
                android:text="අඳුර"
                android:textColor="@color/light_1" />

            <RadioButton
                android:id="@+id/colors_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/light_1"
                android:buttonTint="@color/night_1"
                android:minHeight="48dp"
                android:text="එළිය"
                android:textColor="@color/night_1"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/colors_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/yellow"
                android:buttonTint="@color/blue"
                android:minHeight="48dp"
                android:text="සිතැඟි"
                android:textColor="@color/blue"
                android:textStyle="bold" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_background"
                android:text="පුවරුවේ පසුබිම"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?background" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_pressed_key_background"
                android:text="යතුරු එබීමේදී පසුබිම"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_pressed_key_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground_2" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_long_pressed_key_background"
                android:text="යතුරු ඔබාගෙන සිටීමේදී පසුබිම"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_long_pressed_key_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?accent" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_key_border"
                android:text="යතුරුවල මායිම"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_key_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground_2" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_text"
                android:text="අකුරු, ඉලක්කම්, සංකේත"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_text_dim"
                android:text="අප්‍රධාන අකුරු/සංකේත"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_text_dim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground_2" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_text_long_press"
                android:text="ඔබාගෙන සිටීමෙන් ලියන අකුරු"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_text_long_press"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground" />

            </FrameLayout>

        </LinearLayout>

        <Switch
            android:id="@+id/switch_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="පද්ධතියේ තීරු සඳහා අඳුරු වර්ණ"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_horizontal"
            android:text="යතුරු පුවරුවේ හැසිරීම"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/long_press_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="ඔබාගෙන සිටීමෙන් අකුරු ලිවීම"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/swipe_to_erase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="ඇදගෙන යාමෙන් මැකීම"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/swipe_to_move_cursor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="ඇදගෙන යාමෙන් ලියන තැන වෙනස් කිරීම"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_horizontal"
            android:text="@string/keyboard_help"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/wijesekara_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:text="@string/wijesekara" />

        <Button
            android:id="@+id/singlish_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:text="@string/singlish" />

    </LinearLayout>

</ScrollView>
