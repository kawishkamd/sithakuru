<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_1"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/enable_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:background="@drawable/key_background_not_pressed"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@color/light_1"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="@string/enable_help_title"
                android:textColor="@color/night_1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="@string/enable_help_subtitle"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="4dp"
                android:text="@string/enable_help_step_1"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/enable_help_step_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="@string/enable_help_step_2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="4dp"
                android:text="@string/enable_help_warning"
                android:textColor="@color/light_1"
                android:textSize="14sp"
                android:textStyle="italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="4dp"
                android:text="@string/enable_help_step_3"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/enable_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/blue"
                android:text="@string/enable_button"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/select_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:background="@drawable/key_background_not_pressed"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="@string/select_help_enabled"
                android:textColor="@color/yellow"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@color/light_1"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="@string/select_help_not_selected"
                android:textColor="@color/night_1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:text="@string/select_help_subtitle"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                android:text="@string/select_help_step_1"
                android:textColor="@color/light_1"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="8dp"
                android:text="@string/select_help_step_2"
                android:textColor="@color/light_1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/select_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/yellow"
                android:text="@string/select_button"
                android:textColor="@color/night_1"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_horizontal"
            android:text="@string/section_layouts"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/layout_english"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_wijesekara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/wijesekara"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_singlish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/singlish"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_horizontal"
            android:text="@string/section_appearance"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/key_borders"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_emoji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/emoji_key"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_clipboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/clipboard_key"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_clipboard_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/clipboard_history_save"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/clipboard_expiry_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/clipboard_history_expiry"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/clipboard_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/clipboard_expiry_hour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/light_1"
                android:minHeight="48dp"
                android:text="@string/clipboard_history_expiry_hour"
                android:textColor="@color/light_1" />

            <RadioButton
                android:id="@+id/clipboard_expiry_day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/light_1"
                android:minHeight="48dp"
                android:text="@string/clipboard_history_expiry_day"
                android:textColor="@color/light_1" />

            <RadioButton
                android:id="@+id/clipboard_expiry_never"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/light_1"
                android:minHeight="48dp"
                android:text="@string/clipboard_history_expiry_never"
                android:textColor="@color/light_1" />

        </RadioGroup>

        <Button
            android:id="@+id/clipboard_clear_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:text="@string/clipboard_history_clear_all" />

        <Switch
            android:id="@+id/long_press_keys_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/long_press_keys_labels"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/keyboard_height"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/height_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                tools:text="100%" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/height"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_size"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/light_1"
                android:textSize="16sp"
                tools:text="16dp" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/text_size"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_horizontal"
            android:text="@string/section_colors"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/colors_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/colors_night"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/night_2"
                android:buttonTint="@color/light_1"
                android:minHeight="48dp"
                android:text="@string/theme_night"
                android:textColor="@color/light_1" />

            <RadioButton
                android:id="@+id/colors_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/light_1"
                android:buttonTint="@color/night_1"
                android:minHeight="48dp"
                android:text="@string/theme_light"
                android:textColor="@color/night_1"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/colors_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/yellow"
                android:buttonTint="@color/blue"
                android:minHeight="48dp"
                android:text="@string/theme_custom"
                android:textColor="@color/blue"
                android:textStyle="bold" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_background"
                android:text="@string/color_background"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?background" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_pressed_key_background"
                android:text="@string/color_pressed_key_background"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_pressed_key_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground_2" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_long_pressed_key_background"
                android:text="@string/color_long_pressed_key_background"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_long_pressed_key_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?accent" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_key_border"
                android:text="@string/color_key_border"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_key_border"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground_2" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_text"
                android:text="@string/color_text"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_text_dim"
                android:text="@string/color_text_dim"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_text_dim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground_2" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:labelFor="@id/color_text_long_press"
                android:text="@string/color_text_long_press"
                android:textColor="@color/light_1"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/color_square_border"
                android:padding="4dp">

                <Button
                    android:id="@+id/color_text_long_press"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    tools:background="?foreground" />

            </FrameLayout>

        </LinearLayout>

        <Switch
            android:id="@+id/switch_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/dark_system_bars"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_horizontal"
            android:text="@string/section_behavior"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/long_press_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/long_press_keys"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/swipe_to_erase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/swipe_to_erase"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/swipe_to_move_cursor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/swipe_to_move_cursor"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_english_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:text="@string/english_suggestions"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center_horizontal"
            android:text="@string/keyboard_help"
            android:textColor="@color/light_1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/wijesekara_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:text="@string/wijesekara" />

        <Button
            android:id="@+id/singlish_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:text="@string/singlish" />

    </LinearLayout>

</ScrollView>
