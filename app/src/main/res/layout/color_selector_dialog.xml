<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_inset"
    android:orientation="vertical"
    android:padding="48dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/color_hex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="#dfc540"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp" />

        <View
            android:id="@+id/color_preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            tools:background="?accent" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="රතු"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/red_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/light_1"
            android:textSize="16sp"
            tools:text="223" />

    </LinearLayout>

    <SeekBar
        android:id="@+id/red_value"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="4dp"
        android:max="255"
        android:min="0"
        tools:progress="223" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="කොළ"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/green_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/light_1"
            android:textSize="16sp"
            tools:text="197" />

    </LinearLayout>

    <SeekBar
        android:id="@+id/green_value"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="4dp"
        android:max="255"
        android:min="0"
        tools:progress="197" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="නිල්"
            android:textColor="@color/light_1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/blue_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/light_1"
            android:textSize="16sp"
            tools:text="64" />

    </LinearLayout>

    <SeekBar
        android:id="@+id/blue_value"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="4dp"
        android:max="255"
        android:min="0"
        tools:progress="64" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialogClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/night_1"
            android:minHeight="48dp"
            android:text="@string/dialog_exit" />

        <Button
            android:id="@+id/save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="@color/yellow"
            android:minHeight="48dp"
            android:text="හරි"
            android:textColor="@color/night_1"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
