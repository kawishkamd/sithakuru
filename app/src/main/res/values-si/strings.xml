<resources>
    <string name="app_name">සිතකුරු</string>

    <string name="enable_help_title">සිතකුරු සක්‍රිය කර නැත.</string>
    <string name="enable_help_subtitle">සක්‍රිය කිරීමට උපදෙස්</string>
    <string name="enable_help_step_1">1. ඔබගේ දුරකතනයේ යතුරු පුවරු සැකසුම් වෙත පිවිසීම සඳහා පහත බොත්තම මත ඔබන්න.</string>
    <string name="enable_help_step_2">2. එහි \'%s\' නමින් ඇති යතුරු පුවරුව සක්‍රිය කරන්න.</string>
    <string name="enable_help_warning">එහිදී අනතුරු ඇඟවීම් ලැබේ නම් ඒවා කියවන්න. \'සිතකුරු\' සක්‍රිය කිරීමට අවශ්‍ය නම්, ඒවායේ \'OK\' හෝ \'හරි\' ලෙස දැක්වෙන බොත්තම් ඔබන්න.</string>
    <string name="enable_help_step_3">3. එම සැකසුම් පිටුවෙන් ඉවත් වීම සඳහා දුරකතනයේ පෙර/ආපසු බොත්තම ඔබන්න.</string>
    <string name="enable_button">යතුරු පුවරු සැකසුම් වෙත යන්න</string>

    <string name="select_help_enabled">සිතකුරු සක්‍රිය කර ඇත.</string>
    <string name="select_help_not_selected">නමුත් සිතකුරු තෝරා නැත.</string>
    <string name="select_help_subtitle">සිතකුරු තෝරා ගැනීම සඳහා උපදෙස්</string>
    <string name="select_help_step_1">1. යතුරු පුවරු ලැයිස්තුව විවෘත කිරීම සඳහා පහත බොත්තම මත ඔබන්න.</string>
    <string name="select_help_step_2">2. එම ලැයිස්තුවේ ඇති \'Sithakuru\' යන වචනය මත ඔබන්න.</string>
